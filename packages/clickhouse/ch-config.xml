<clickhouse>
    <!-- should be 2 * NUM_CPU_CORES. Default 16 -->
    <max_concurrent_queries>4</max_concurrent_queries>

    <!-- Hard server-wide memory cap: 2 GiB. Without this, ClickHouse sizes
         itself off the host's visible RAM (Railway containers see the whole
         host) and idles at 6+ GiB for ~1.3 GiB of data. Dataset is small and
         queries are already capped at 10s, so 2 GiB is generous. -->
    <max_server_memory_usage>2147483648</max_server_memory_usage>

    <!-- mark cache sized to the actual dataset (~1.3 GiB on disk): 256 MiB -->
    <mark_cache_size>268435456</mark_cache_size>

    <!-- Default is 512 threads; a single-tenant analytics DB needs far fewer -->
    <background_schedule_pool_size>16</background_schedule_pool_size>

    <!-- Hold idle HTTP keep-alive connections for 5 min instead of the 10s default,
         so the Plausible ch driver's pooled connections stop getting reaped server-side.
         Fixes the "Ch.Connection ... disconnected (Mint.HTTPError)" log flood. -->
    <keep_alive_timeout>300</keep_alive_timeout>

    <!-- Stop all the unnecessary logging -->
    <query_thread_log remove="remove"/>
    <query_log remove="remove"/>
    <text_log remove="remove"/>
    <trace_log remove="remove"/>
    <metric_log remove="remove"/>
    <asynchronous_metric_log remove="remove"/>
    <session_log remove="remove"/>
    <part_log remove="remove"/>
    <!-- merge tree  -->
    <merge_tree>
        <!-- default is 8192 -->
        <merge_max_block_size>2048</merge_max_block_size>
        <max_bytes_to_merge_at_max_space_in_pool>1073741824</max_bytes_to_merge_at_max_space_in_pool>
        <number_of_free_entries_in_pool_to_lower_max_size_of_merge>0</number_of_free_entries_in_pool_to_lower_max_size_of_merge>
    </merge_tree>
</clickhouse>
